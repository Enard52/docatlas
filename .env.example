DOCATLAS_DATA_DIR=./data
# bm25 is dependency-light. Install .[semantic] and set fastembed for hybrid retrieval.
DOCATLAS_EMBEDDINGS=bm25
DOCATLAS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional initial settings; saved browser Model setup settings take precedence.
# DOCATLAS_LLM_URL=http://127.0.0.1:1234/v1
# DOCATLAS_LLM_MODEL=your-installed-model
# DOCATLAS_LLM_KEY=
DOCATLAS_LLM_KIND=lmstudio
DOCATLAS_LLM_FORMAT=json_schema
DOCATLAS_LLM_TIMEOUT=120
DOCATLAS_LLM_CONTEXT_TOKENS=8192
DOCATLAS_LLM_MAX_TOKENS=1400
# Required when exposing beyond localhost. Passed as X-API-Key by clients.
# DOCATLAS_API_KEY=
DOCATLAS_RATE_LIMIT=60
DOCATLAS_MAX_UPLOAD_MB=10
# Durable upload worker: one process at a time, with parent-owned limits.
DOCATLAS_INGESTION_TIMEOUT=180
DOCATLAS_WORKER_MEMORY_MB=1024
